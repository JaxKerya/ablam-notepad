# Bu dosyayı .env.local olarak kopyala ve doldur.
# Nerede lazım:  [Vercel] site ve API'ler   [VPS] Ablam Kariyer tarayıcısı   [ikisi] her ikisi
# Zorunlu olmayanlar boş bırakılabilir; boşken yanındaki varsayılan geçerlidir.


# ============ VERİ TABANI [ikisi] ============
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key


# ============ YAPAY ZEKÂ [ikisi] ============
# OpenRouter (OpenAI uyumlu). Tüm modeller buradan çağrılır.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your-openrouter-key

# Üretim — transkript çözümleme, soru üretimi, not/özet (Ablam Ders)
AI_MODEL=openai/gpt-5.6-sol
# İlan puanlama (Kariyer) — günlük en çok çağrılan model. Boş = AI_MODEL
AI_GRADE_MODEL=openai/gpt-5.6-sol
# Hakem — soruların cevap anahtarı denetimi. Üreticiden farklı model olsun, ucuz yeter
AI_AUDIT_MODEL=openai/gpt-5.6-luna
# Profil çıkarma — Kariyer'de tek seferlik, kaliteli model. Boş = AI_MODEL
AI_PROFIL_MODEL=anthropic/claude-fable-5.1
# Geliştirme — üretici kendi sorularını ikinci kez okuyup çeldiricileri güçlendirir.
# Ders başına maliyeti ~%40 artırır, hakem zaten hataları yakalıyor. Boş = kapalı (önerilen)
AI_REFINE_MODEL=
# Düşünme derinliği: low | medium | high | xhigh. Boş = sağlayıcı varsayılanı
AI_EFFORT=


# ============ ABLAM DERS [Vercel] ============
# Giriş çerezi imzası — rastgele uzun bir metin
SITE_GATE_SECRET=rastgele-uzun-bir-metin
# YouTube transkripti — supadata.ai (ücretsiz katman 100 kredi/ay)
SUPADATA_API_KEY=your-supadata-key
# Video yayın tarihi — YouTube Data API v3 (ücretsiz). Boş = dersler ekleme sırasına göre dizilir
YOUTUBE_API_KEY=


# ============ ABLAM YOUTUBE [Vercel] ============
# Bölüm ablama açık mı? false = ana sayfada gizli, /youtube "Yakında" (geliştiren /youtube?onizleme=1 ile görür).
# Stüdyo (evdeki bilgisayar, gece/gece/worker.py) bundan bağımsız çalışır. Boş = açık
NEXT_PUBLIC_YOUTUBE_ACIK=false


# ============ ABLAM KARİYER — SİTE [Vercel] ============
# Bölüm ablama açık mı? false = ana sayfada "Yakında", /kariyer kapalı (geliştiren /kariyer?onizleme=1 ile görür).
# Tarayıcı yine çalışır. Boş = açık
NEXT_PUBLIC_KARIYER_ACIK=false
# Nabız cron'unun (her sabah) şifresi — rastgele uzun bir metin. VPS 6 saat sessiz kalırsa e-posta atar
CRON_SECRET=


# ============ ABLAM KARİYER — TARAYICI [VPS] ============
# E-posta: resend.com (ücretsiz katman yeter). Alan adı doğrulanmadıysa yalnızca
# hesap sahibinin adresine gönderir; hesabı bildirimi alacak kişinin e-postasıyla aç
RESEND_API_KEY=re_...
# Gönderen adres (alan adı doğruladıysan). Boş = onboarding@resend.dev
RESEND_FROM=
# Kaynak kırılınca uyarı gidecek adres. Boş = profildeki bildirim adresi
UYARI_EPOSTA=

# Günlük model harcaması tavanı (USD). Aşınca ilanlar kaydedilir, puanlama ertesi güne kalır. Boş = 1
GUNLUK_MALIYET_USD=10

# İlan kaynakları — anahtarsızlar (İŞKUR, ilan.gov.tr, Kariyer Kapısı, LinkedIn, İş Bul, Eleman.net) hep açık
# Jooble — https://tr.jooble.org/api/about (ücretsiz). Boş = kaynak atlanır
JOOBLE_API_KEY=
# Careerjet — https://www.careerjet.com.tr/partners/api (ücretsiz). Boş = kaynak atlanır
CAREERJET_API_KEY=
# Careerjet zorunlu tutuyor: VPS'in dış IP'si (yayıncı panelinde de izinli olmalı)
CAREERJET_USER_IP=
# Careerjet yayıncı hesabında bildirilen site adresi (Referer olarak gider)
CAREERJET_SITE=

# Zamanlama (dakika). Boş = varsayılan
# Döngü aralığı — varsayılan 60
TARAMA_ARALIGI_DK=
# İŞKUR Chromium açıyor, ağır — varsayılan 360
ISKUR_ARALIK_DK=
# LinkedIn sık vurulursa engeller — varsayılan 480
LINKEDIN_ARALIK_DK=
# Eleman.net HTML tarama — varsayılan 180
ELEMAN_ARALIK_DK=

# Nadiren gerekenler
# Yalnızca bu kaynaklar koşsun (virgülle): iskur,ilangov,kariyerkapisi,linkedin,jooble,careerjet,isbul,eleman. Boş = hepsi
KAYNAKLAR=
# Chromium yolu (npx playwright install chromium). Boş = yerel Chrome denenir
TARAYICI_YOLU=
