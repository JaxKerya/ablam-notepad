NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Ablam Ders — AI saglayici (OpenAI uyumlu)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your-gateway-key
AI_MODEL=openai/gpt-5.6-sol
# Degerlendirme modeli (bos birakilirsa AI_MODEL'in varsayilani kullanilir)
AI_GRADE_MODEL=openai/gpt-5.6-sol
# Cevap anahtari denetimi (ucuz ve hizli model yeter)
AI_AUDIT_MODEL=openai/gpt-5.6-luna
# Oz-denetim (deney): uretim modeli kendi sorularini ikinci kez okuyup zayif
# celdiricileri guclendirir. BOS = adim calismaz. Genelde AI_MODEL ile ayni.
AI_REFINE_MODEL=
# Dusunme derinligi: low | medium | high | xhigh. Bos = saglayici varsayilani.
# Yalnizca uretim ve oz-denetim cagrilarina gider.
AI_EFFORT=

# Ablam Ders — YouTube transkript servisi (supadata.ai, ucretsiz katman 100 kredi/ay)
SUPADATA_API_KEY=your-supadata-key

# Ablam Ders — giris cerezi imzasi (rastgele uzun bir metin)
SITE_GATE_SECRET=rastgele-uzun-bir-metin

# Ablam Ders — video yayin tarihi (YouTube Data API v3, ucretsiz 10.000 birim/gun)
# Bos birakilirsa dersler yayin tarihine gore siralanmaz, ekleme sirasina duser.
YOUTUBE_API_KEY=your-youtube-data-api-key

# Ablam Kariyer — bölüm ablama açık mı? "false" iken ana sayfada "yakında", /kariyer yakında ekranı;
# tarayıcı yine çalışır. Geliştiren kişi /kariyer?onizleme=1 ile görür. Boş = açık.
NEXT_PUBLIC_KARIYER_ACIK=

# Ablam Kariyer — profil çıkarma modeli (nadir çağrı, sonucu her puanlamaya giriyor;
# pahalı model ödenebilir). Boşsa AI_MODEL.
AI_PROFIL_MODEL=anthropic/claude-fable-5.1

# Ablam Kariyer — tarayıcı (VPS'te çalışır; worker/ana.ts)
# Bildirimler Resend ile gönderilir (resend.com, ücretsiz katman yeter).
# Alan adı doğrulanmadan yalnızca hesap sahibinin adresine gönderir; hesabı
# bildirimi alacak kişinin e-postasıyla açın.
RESEND_API_KEY=re_...
# Alan adı doğruladıysanız kendi adresiniz; yoksa boş bırakın (onboarding@resend.dev kullanılır)
RESEND_FROM=
# Kaynak kırılınca uyarı gidecek adres (boşsa profildeki bildirim adresi)
UYARI_EPOSTA=
# Döngü modunda taramalar arası dakika (varsayılan 60)
TARAMA_ARALIGI_DK=60
# İŞKUR iki tarama arası en az dakika (Chromium sürüyor; varsayılan 360 = günde 4)
ISKUR_ARALIK_DK=
# Günlük model harcaması tavanı, USD (varsayılan 1). Aşınca ilanlar kaydedilir, puanlama ertesi güne kalır.
GUNLUK_MALIYET_USD=
# Nabız (app/api/kariyer/nabiz, Vercel cron): tarayıcı 6 saat sessiz kalırsa e-posta.
# Vercel'de Environment Variables'a CRON_SECRET (rastgele uzun metin) ve RESEND_API_KEY eklenmeli.
CRON_SECRET=
# VPS'te Chromium yolu (npx playwright install chromium). Boşsa yerel Chrome denenir.
TARAYICI_YOLU=
# Yalnızca bu kaynaklar koşsun (virgülle; boş = hepsi): iskur,ilangov,kariyerkapisi,linkedin,jooble,careerjet
KAYNAKLAR=
# LinkedIn iki tarama arası en az dakika (varsayılan 720 = günde 2)
LINKEDIN_ARALIK_DK=
# Jooble REST API anahtarı — https://tr.jooble.org/api/about formundan (ücretsiz). Boşsa kaynak atlanır.
JOOBLE_API_KEY=
# Careerjet yayıncı API anahtarı — https://www.careerjet.com.tr/partners/api (ücretsiz). Boşsa kaynak atlanır.
CAREERJET_API_KEY=
# Careerjet user_ip parametresi zorunlu; VPS'in dış IP'si (boşsa 127.0.0.1 gönderilir)
CAREERJET_USER_IP=
# Careerjet yayıncı hesabında bildirilen site (Referer başlığı olarak gider; boşsa yer tutucu)
CAREERJET_SITE=
