NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Ablam Ders — AI saglayici (OpenAI uyumlu)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your-gateway-key
AI_MODEL=openai/gpt-5.6-sol
# Degerlendirme modeli (bos birakilirsa AI_MODEL'in varsayilani kullanilir)
AI_GRADE_MODEL=openai/gpt-5.6-sol
# Cevap anahtari denetimi (ucuz ve hizli model yeter)
AI_AUDIT_MODEL=openai/gpt-5.6-luna

# Ablam Ders — YouTube transkript servisi (supadata.ai, ucretsiz katman 100 kredi/ay)
SUPADATA_API_KEY=your-supadata-key

# Ablam Ders — giris cerezi imzasi (rastgele uzun bir metin)
SITE_GATE_SECRET=rastgele-uzun-bir-metin

# Ablam Ders — video yayin tarihi (YouTube Data API v3, ucretsiz 10.000 birim/gun)
# Bos birakilirsa dersler yayin tarihine gore siralanmaz, ekleme sirasina duser.
YOUTUBE_API_KEY=your-youtube-data-api-key
